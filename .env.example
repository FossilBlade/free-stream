# Everything here can also be set from the app's Settings page (values saved there win).

# Port the app listens on. Open http://<this-mac-ip>:PORT on any device on your Wi-Fi.
PORT=8080

# Where app state (settings, watch progress, my list) is stored.
# DATA_DIR=./data

# Where torrent downloads are cached. Defaults to ~/Movies/FreeStream
# DOWNLOAD_DIR=

# TMDB (free): https://www.themoviedb.org/settings/api — either the v3 "API Key"
# or the v4 "API Read Access Token" works.
TMDB_API_KEY=

# Torrent indexer manager running on this Mac: prowlarr | jackett
INDEXER_TYPE=prowlarr
# Prowlarr default: http://localhost:9696   Jackett default: http://localhost:9117
INDEXER_URL=http://localhost:9696
INDEXER_API_KEY=

# Max disk space for cached downloads, in GB. Oldest unwatched downloads are removed first.
CACHE_LIMIT_GB=50

# Time zone for nightly jobs (suggestions run at 3am local time), e.g. Europe/London or America/New_York
TZ=UTC
